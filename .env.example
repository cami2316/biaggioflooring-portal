SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_REPLY_TO=biaggioflooringllc@gmail.com

# Supabase (server-side only — never expose service role to the browser)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase (browser-safe — anon key only)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Calendar .ics feed — generate a random secret: openssl rand -hex 32
ICS_SECRET=
# Expose a NON-secret token to the browser for the .ics link button (can be same value or a separate public token)
NEXT_PUBLIC_ICS_TOKEN=
